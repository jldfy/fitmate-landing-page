{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(robots.txt|llms.txt|llms-full.txt|sitemap.xml|sitemap-pages.xml|sitemap-events.xml|events.ics|api/public/events.json)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
